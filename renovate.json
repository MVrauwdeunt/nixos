
{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "nix",
    "custom.regex"
  ],
  "nix": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Podman images in NixOS modules",
      "managerFilePatterns": [
        "/^modules\\/containers\\/.*\\.nix$/"
      ],
      "matchStrings": [
        "(?:image|default)\\s*=\\s*\"(?<depName>(?:docker\\.io|ghcr\\.io|lscr\\.io|codeberg\\.org)/[^\"\\s:]+):(?<currentValue>v?\\d+(?:\\.\\d+)*(?:[-.][A-Za-z0-9.]+)?)\";"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "* * * * 0"
    ],
    "commitMessageAction": "Update",
    "commitMessageTopic": "flake.lock"
  },
  "labels": [
    "dependencies"
  ],
  "prHourlyLimit": 2,
  "prConcurrentLimit": 5,
  "automerge": false,
  "packageRules": [
    {
      "matchManagers": [
        "nix"
      ],
      "groupName": "flake inputs"
    }
  ]
}


{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "nix",
    "custom.regex"
  ],
  "nix": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "NixOS Podman container images",
      "managerFilePatterns": [
        "/^modules\\/containers\\/.*\\.nix$/"
      ],
      "matchStrings": [
        "(?:image|default)\\s*=\\s*\"(?<depName>(?:docker\\.io|ghcr\\.io|lscr\\.io|codeberg\\.org|docker\\.stirlingpdf\\.com)/[^\"\\s@:]+(?:/[^\"\\s@:]+)*):(?<currentValue>[^\"@\\s]+)@(?<currentDigest>sha256:[a-f0-9]{64})\""
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "* * * * 0"
    ],
    "commitMessageAction": "Update",
    "commitMessageTopic": "flake.lock"
  },
  "labels": [
    "dependencies"
  ],
  "prHourlyLimit": 2,
  "prConcurrentLimit": 5,
  "automerge": false,
  "dependencyDashboard": true,
  "packageRules": [
    {
      "matchManagers": [
        "nix"
      ],
      "groupName": "flake inputs"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "pinDigests": true
    }
  ]
}

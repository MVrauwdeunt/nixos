{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "nix"
  ],
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* * * * 0"],
    "commitMessageAction": "Update",
    "commitMessageTopic": "flake.lock"
  },
  "labels": [
    "dependencies"
  ],
  "prHourlyLimit": 2,
  "prConcurrentLimit": 5,
  "automerge": false,
  "packageRules": [
    {
      "matchManagers": ["nix"],
      "groupName": "flake inputs"
    }
  ]
}
